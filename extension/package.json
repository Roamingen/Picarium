{
  "name": "stickerbox-extension",
  "private": true,
  "version": "0.1.0",
  "description": "StickerBox 浏览器导入扩展（MV3 + TypeScript + esbuild）",
  "scripts": {
    "build": "esbuild src/background.ts --bundle --format=esm --target=chrome110 --outfile=dist/background.js && node -e \"require('node:fs').copyFileSync('manifest.json','dist/manifest.json')\"",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/media.test.ts --bundle --platform=node --format=cjs --outfile=dist-test/media.test.cjs && node --test dist-test/media.test.cjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
