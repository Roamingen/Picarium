{
  "manifest_version": 3,
  "name": "Picarium 导入",
  "version": "0.6.0",
  "description": "右键或悬停把 B站 图片/动图存进本地 Picarium、复制为文件或下载到本地",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "contextMenus",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:17800/*",
    "https://*.bilibili.com/*",
    "https://*.hdslb.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Picarium：右键图片可导入",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  }
}
