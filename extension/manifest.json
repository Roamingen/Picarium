{
  "manifest_version": 3,
  "name": "StickerBox 导入",
  "version": "0.4.0",
  "description": "右键或悬停把 B站 图片/动图存进本地 StickerBox，或以文件形式复制到剪贴板",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:17800/*",
    "https://*.bilibili.com/*",
    "https://*.hdslb.com/*"
  ],
  "action": {
    "default_title": "StickerBox：右键图片可导入"
  }
}
